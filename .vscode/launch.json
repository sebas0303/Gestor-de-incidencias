{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Flask (Gestor de Incidencias)",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_DEBUG": "1",
                "LMSTUDIO_URL": "http://localhost:1234/v1",
                "LMSTUDIO_MODEL": "local-model"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload"
            ],
            "jinja": true,
            "autoStartBrowser": false
        }
    ]
}

